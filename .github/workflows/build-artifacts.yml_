name: Build Native Executables

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch: # To trigger the build manually from the GitHub website

jobs:
  build:
    name: Build Native on ${{ matrix.os }}
    runs-on: ${{ matrix.os }}
    strategy:
      fail-fast: false
      matrix:
        # Compile for Linux and Windows in parallel
        os: [windows-latest] # ubuntu-latest,

    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      # 1. Configure GraalVM (install the JDK and the native tools corresponding to the OS)
      - name: Set up GraalVM
        uses: graalvm/setup-graalvm@v1
        with:
          java-version: '25'
          distribution: 'graalvm'
          github-token: ${{ secrets.GITHUB_TOKEN }}
          native-image-job-reports: 'true'

      # 2. Configure the Maven cache to make next builds fast
      - name: Cache Maven packages
        uses: actions/cache@v5
        with:
          path: ~/.m2
          key: ${{ runner.os }}-m2-${{ hashFiles('**/pom.xml') }}
          restore-keys: ${{ runner.os }}-m2

      # 3. Compile using the native profile (-Pnative) that we configured in the pom.xml
      - name: Build Native Image
        run: mvn clean package -Pnative

      # 4. Upload the resulting binaries as downloadable GitHub artifacts
      - name: Upload Linux Executable
        if: matrix.os == 'ubuntu-latest'
        uses: actions/upload-artifact@v6
        with:
          name: phatjellyfin-linux
          path: target/phatjellyfin

      - name: Upload Windows Executable
        if: matrix.os == 'windows-latest'
        uses: actions/upload-artifact@v6
        with:
          name: phatjellyfin-windows
          path: target/phatjellyfin.exe
